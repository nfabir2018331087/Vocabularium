generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Word {
  id          String   @id @default(cuid())
  word        String
  language    Language
  meaning     String
  explanation String?
  examples    String[]
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([language])
  @@index([createdAt])
}

enum Language {
  BANGLA
  ENGLISH
}
